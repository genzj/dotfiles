binds {
    Mod+Shift+Slash hotkey-overlay-title="Show Cheatsheet" {
        spawn "dms" "ipc" "call" "keybinds" "toggle" "niri";
    }

    Mod+B hotkey-overlay-title="Open Browser" { spawn "google-chrome-stable"; }
    Mod+E hotkey-overlay-title="Open Files" { spawn "nautilus"; }

    Ctrl+Alt+Shift+Equal hotkey-overlay-title="Brightness Up" {
       spawn "dms" "ipc" "call" "brightness" "increment" "5" "";
    }
    Ctrl+Alt+Shift+Minus hotkey-overlay-title="Brightness Down" {
       spawn "dms" "ipc" "call" "brightness" "decrement" "5" "";
    }

    // https://github.com/hthienloc/dms-quick-capture
    // install by `dms plugins install quickCapture`
    Mod+F1 { spawn "dms" "ipc" "call" "quickCapture" "screenshot" "region" "edit"; }
}
